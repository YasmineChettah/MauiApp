<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MAUI_TD.ViewModels"
             x:Class="MAUI_TD.Views.LoginPage"
             Title="Connexion">

    <VerticalStackLayout Padding="40" Spacing="16" VerticalOptions="Center">

        <Label Text="🎮 Morpion" FontSize="32" HorizontalOptions="Center" />

        <Entry Placeholder="Email"
               Text="{Binding Email}"
               Keyboard="Email" />

        <Entry Placeholder="Mot de passe"
               Text="{Binding Password}"
               IsPassword="True" />

        <Label Text="{Binding ErrorMessage}"
               TextColor="Red" />

        <Button Text="Se connecter" Command="{Binding LoginCommand}" />
        <Button Text="S'inscrire" Command="{Binding RegisterCommand}" BackgroundColor="Gray" />

    </VerticalStackLayout>
</ContentPage>